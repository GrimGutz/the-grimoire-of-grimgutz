{
  "name": "the-grimoire-of-grimgutz",
  "version": "0.15.23",
  "private": true,
  "type": "module",
  "description": "Development sources for The Grimoire of GrimGutz Foundry VTT module.",
  "scripts": {
    "build": "node tools/build-packs.mjs",
    "validate": "node tools/validate.mjs",
    "coverage": "node tools/automation-coverage.mjs",
    "test": "node tools/test.mjs",
    "verify": "npm run lint && npm run test && npm run validate",
    "check": "npm run format:check && npm run lint && npm run test && npm run build && npm run validate",
    "format": "prettier --write \"scripts/**/*.mjs\" \"src/**/*.mjs\" \"tools/**/*.mjs\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"src/**/*.mjs\" \"tools/**/*.mjs\" \"tests/**/*.mjs\"",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "classic-level": "3.0.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
